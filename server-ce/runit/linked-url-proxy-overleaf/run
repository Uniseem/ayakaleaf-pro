#!/bin/bash

source /etc/overleaf/env.sh
export LISTEN_ADDRESS=127.0.0.1

# The Go implementation is what this service is: services-go/cmd/linked-url-proxy.
#
# The Node one is still in the image, and LINKED_URL_PROXY_IMPL=node puts it back, so a
# rollback is one environment variable and a restart rather than a rebuild.
if [ "$LINKED_URL_PROXY_IMPL" != "node" ] && [ -x /overleaf/bin/go/linked-url-proxy ]; then
    exec /sbin/setuser www-data /overleaf/bin/go/linked-url-proxy >> /var/log/overleaf/linked-url-proxy.log 2>&1
fi

NODE_PARAMS=""
if [ "$DEBUG_NODE" == "true" ]; then
    echo "running debug - linked-url-proxy"
    NODE_PARAMS="--inspect=0.0.0.0:30660"
fi

exec /sbin/setuser www-data /usr/bin/node $NODE_PARAMS /overleaf/services/linked-url-proxy/app.mjs >> /var/log/overleaf/linked-url-proxy.log 2>&1
