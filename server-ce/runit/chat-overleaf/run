#!/bin/bash

source /etc/overleaf/env.sh
export LISTEN_ADDRESS=127.0.0.1

# The Go implementation is what this service is: services-go/cmd/chat.
#
# The Node one is still in the image, and CHAT_IMPL=node puts it back, so a
# rollback is one environment variable and a restart rather than a rebuild.
if [ "$CHAT_IMPL" != "node" ] && [ -x /overleaf/bin/go/chat ]; then
    exec /sbin/setuser www-data /overleaf/bin/go/chat >> /var/log/overleaf/chat.log 2>&1
fi

NODE_PARAMS=""
if [ "$DEBUG_NODE" == "true" ]; then
    echo "running debug - chat"
    NODE_PARAMS="--inspect=0.0.0.0:30100"
fi

exec /sbin/setuser www-data /usr/bin/node $NODE_PARAMS /overleaf/services/chat/app.js >> /var/log/overleaf/chat.log 2>&1
