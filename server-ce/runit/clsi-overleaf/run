#!/bin/bash

# The compiler (services-go/cmd/clsi).
#
# The Node implementation is not in the image any more. CLSI_IMPL exists only
# so that the name is not a surprise if it turns up in a deployment's
# environment; there is nothing to switch to.

# Set permissions on docker.sock if present, so that a sandboxed compile can
# start a container of its own.
if [ -e '/var/run/docker.sock' ]; then
  echo ">> Setting permissions on docker socket"
  DOCKER_GROUP=$(stat -c '%g' /var/run/docker.sock)
  groupadd --non-unique --gid "${DOCKER_GROUP}" dockeronhost
  usermod -aG dockeronhost www-data
fi

source /etc/overleaf/env.sh
export LISTEN_ADDRESS=127.0.0.1

exec /sbin/setuser www-data /overleaf/bin/go/clsi >> /var/log/overleaf/clsi.log 2>&1
