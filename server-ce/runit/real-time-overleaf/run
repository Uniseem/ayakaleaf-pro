#!/bin/bash

source /etc/overleaf/env.sh
export LISTEN_ADDRESS=127.0.0.1

# The Go implementation is what this service is: services-go/cmd/real-time.
#
# The Node one is still in the image, and REALTIME_IMPL=node puts it back, so a
# rollback is one environment variable and a restart rather than a rebuild.
if [ "$REALTIME_IMPL" != "node" ] && [ -x /overleaf/bin/go/real-time ]; then
    # The editor loads its socket.io client from this service, exactly as the
    # Node app.js serves it out of the socket.io-client package. Without it the
    # project page cannot open at all.
    export SOCKET_IO_CLIENT_JS=/overleaf/node_modules/socket.io-client/dist/socket.io.min.js
    # /etc/overleaf/settings.js replaces the Redis key schema of every service
    # with an unbraced one -- PendingUpdates:<id> rather than the
    # PendingUpdates:{<id>} in the services own defaults. Writing the wrong
    # names is silent: real-time queues an edit under a key document-updater is
    # not reading, and the editor declares the document out of sync.
    export REDIS_KEY_SCHEMA=server-ce
    exec /sbin/setuser www-data /overleaf/bin/go/real-time >> /var/log/overleaf/real-time.log 2>&1
fi

exec /sbin/setuser www-data /usr/bin/node /overleaf/services/real-time/app.js >> /var/log/overleaf/real-time.log 2>&1
