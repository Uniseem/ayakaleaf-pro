# The Node services. Every one of them is Go now, built from services-go and
# copied in as a binary. The sources stay in the repository -- the conformance
# suite runs the Go ports against them -- and none of them ships.
services/web
services/chat
services/clsi
services/docstore
services/document-updater
services/filestore
services/history-v1
services/linked-url-proxy
services/notifications
services/project-history
services/real-time
