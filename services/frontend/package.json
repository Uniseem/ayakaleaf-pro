{
  "name": "@overleaf/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "The web client. A rewrite: it shares no code with services/web/frontend.",
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/copy-pdf-worker.mjs && node scripts/generate-latex-parser.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs && node scripts/generate-latex-parser.mjs",
    "latex-parser": "node scripts/generate-latex-parser.mjs --force",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.18.4",
    "@codemirror/commands": "6.10.1",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.1",
    "@codemirror/lint": "6.9.2",
    "@codemirror/search": "6.5.8",
    "@codemirror/state": "6.5.4",
    "@codemirror/view": "6.38.6",
    "@lezer/common": "1.5.0",
    "@lezer/highlight": "1.2.3",
    "@lezer/lr": "1.4.7",
    "@lezer/markdown": "1.6.3",
    "@replit/codemirror-emacs": "6.1.0",
    "@replit/codemirror-indentation-markers": "6.5.3",
    "@replit/codemirror-vim": "^6.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "framer-motion": "^11.11.0",
    "next": "^15.5.25",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^2.1.7"
  },
  "devDependencies": {
    "@lezer/generator": "1.8.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "patch-package": "8.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.5"
  }
}
